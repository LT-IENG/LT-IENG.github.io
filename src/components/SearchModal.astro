---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((p) => ({
    slug: p.slug,
    title: p.data.title,
    section: p.data.section,
    date: p.data.date.toISOString().slice(0, 10),
    tags: p.data.tags,
    desc: p.data.description || '',
  }));
---

<div class="so" id="searchOverlay" aria-hidden="true">
  <div class="so-bg" id="searchBackdrop"></div>
  <div class="so-box">
    <input
      type="text" id="searchInput" class="so-input"
      placeholder="搜索文章…" autocomplete="off"
    />
    <div class="so-list" id="searchResults"></div>
    <div class="so-empty" id="searchEmpty">输入关键词搜索文章</div>
  </div>
</div>

<div id="postData" style="display:none" data-posts={JSON.stringify(posts)}></div>

<script>
  const pel = document.getElementById('postData');
  const postData = pel ? JSON.parse(pel.getAttribute('data-posts') || '[]') : [];
  const overlay = document.getElementById('searchOverlay');
  const bg = document.getElementById('searchBackdrop');
  const input = document.getElementById('searchInput');
  const list = document.getElementById('searchResults');
  const empty = document.getElementById('searchEmpty');

  function open() {
    overlay.setAttribute('aria-hidden', 'false');
    overlay.classList.add('on');
    document.body.style.overflow = 'hidden';
    setTimeout(() => input.focus(), 100);
  }
  function close() {
    overlay.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('on');
    document.body.style.overflow = '';
    input.value = '';
    list.innerHTML = '';
    empty.style.display = '';
  }
  document.getElementById('searchTrigger')?.addEventListener('click', open);
  bg.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('on')) close();
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); open(); }
  });

  const sc = { '项目作品':'#c4a882','技术探索':'#5b7a8c','阅读笔记':'#b8937a','闲隅拾笺':'#8b9d83' };

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    if (!q) { list.innerHTML = ''; empty.style.display = ''; return; }
    empty.style.display = 'none';
    const hits = postData.filter(p =>
      p.title.toLowerCase().includes(q) ||
      p.tags.some(t => t.toLowerCase().includes(q)) ||
      p.section.toLowerCase().includes(q) ||
      (p.desc && p.desc.toLowerCase().includes(q))
    ).slice(0, 8);
    if (!hits.length) { list.innerHTML = '<div class="so-none">无匹配结果</div>'; return; }
    list.innerHTML = hits.map(p => `
      <a href="/blog/${p.slug}" class="so-row">
        <span class="so-sec" style="color:${sc[p.section]||'#999'}">${p.section}</span>
        <span class="so-title">${p.title}</span>
        <span class="so-date">${p.date}</span>
      </a>
    `).join('');
  });
</script>

<style is:global>
  .so {
    position: fixed; inset: 0; z-index: 200;
    display: flex; align-items: flex-start; justify-content: center;
    padding-top: 20vh;
    pointer-events: none; opacity: 0;
    transition: opacity 0.18s;
  }
  .so.on { pointer-events: auto; opacity: 1; }
  .so-bg {
    position: absolute; inset: 0;
    background: rgba(26,26,46,0.3);
  }
  .so-box {
    position: relative;
    width: 92%; max-width: 500px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.1);
    padding: 1.25rem 1.25rem 0.5rem;
  }
  .so-input {
    width: 100%;
    border: none; outline: none;
    font-size: 1.05rem; font-family: inherit;
    color: var(--color-ink);
    padding: 0.4rem 0.4rem 0.75rem;
    margin-bottom: 0.25rem;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }
  .so-input::placeholder { color: var(--color-ink-light); opacity: 0.5; }
  .so-empty, .so-none {
    text-align: center; color: var(--color-ink-light);
    font-size: 0.85rem; padding: 2rem 0 1.5rem;
  }
  .so-none { padding: 1.5rem 0 1rem; }

  .so-list {
    display: flex; flex-direction: column;
    padding: 0.25rem 0;
  }
  .so-row {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.75rem 0.6rem;
    text-decoration: none; color: inherit;
    border-radius: 6px;
    border-bottom: 1px solid rgba(0,0,0,0.04);
    transition: background 0.15s;
  }
  .so-row:last-child { border-bottom: none; }
  .so-row:hover { background: #f7f4ef; }
  .so-sec {
    font-size: 0.7rem; font-weight: 500;
    white-space: nowrap;
  }
  .so-title {
    font-size: 0.9rem; font-weight: 500; line-height: 1.45;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .so-date {
    font-size: 0.65rem; color: var(--color-ink-light); opacity: 0.6;
    font-family: var(--font-mono); white-space: nowrap; flex-shrink: 0;
  }
</style>
