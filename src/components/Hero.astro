---
import { ParticleNetwork } from './ParticleBackground.ts';
---

<section class="hero" id="hero">
  <canvas class="hero-canvas" id="heroCanvas"></canvas>

  <div class="hero-inner">
    <div class="hero-identity">
      <h1 class="hero-name">LT-IENG</h1>
      <p class="hero-subtitle">此刻，未来</p>
      <p class="hero-desc">热爱，是所有的理由和答案</p>
    </div>

    <div class="hero-slider-area">
      <slot name="slider" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 650px;
    overflow: hidden;
    background: radial-gradient(ellipse 80% 60% at 50% 35%, #fcfaf7 0%, #f5f0ea 40%, #e8e1d5 100%);
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 5rem 2rem 2rem;
    box-sizing: border-box;
  }
  .hero-identity {
    text-align: center;
    margin-bottom: clamp(2rem, 6vh, 5rem);
  }
  .hero-name {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 7vw, 6rem);
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: 0.05em;
    margin: 0;
    line-height: 1.05;
  }
  .hero-subtitle {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--color-gold);
    margin: 0.6rem 0 0.4rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  .hero-desc {
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    color: var(--color-ink-light);
    margin: 0.75rem auto 0;
    max-width: 400px;
    line-height: 1.6;
  }
  .hero-slider-area {
    width: 100%;
    max-width: 1200px;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 560px;
    }
    .hero-inner {
      padding: 4rem 1rem 1rem;
    }
    .hero-identity {
      margin-bottom: 2rem;
    }
  }
</style>

<script>
  const canvas = document.getElementById('heroCanvas') as HTMLCanvasElement | null;
  if (canvas) {
    new ParticleNetwork(canvas);
  }
</script>
