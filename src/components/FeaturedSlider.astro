---
import { getCollection } from 'astro:content';
import FeaturedCard from './FeaturedCard.astro';

const allPosts = await getCollection('blog');
const featured = allPosts
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const posts = featured.slice(0, 6);
const padPosts = posts.length >= 4
  ? posts
  : [...posts, ...posts, ...posts].slice(0, 6);
---

<div class="slider" id="featuredSlider">
  <div class="slider-track" id="sliderTrack">
    <div class="slider-set" id="sliderSet">
      {padPosts.map((post) => (
        <FeaturedCard post={post} />
      ))}
    </div>
    <div class="slider-set" aria-hidden="true">
      {padPosts.map((post) => (
        <FeaturedCard post={post} />
      ))}
    </div>
  </div>
</div>

<style>
  .slider {
    width: 100%;
    overflow: hidden;
    padding: 0.5rem 0 1rem;
  }
  .slider-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    will-change: transform;
    cursor: grab;
    /* Let the browser handle vertical page scroll; we own horizontal drags */
    touch-action: pan-y;
  }
  .slider-track.dragging {
    cursor: grabbing;
    user-select: none;
    -webkit-user-select: none;
  }
  .slider-set {
    display: flex;
    gap: 1.25rem;
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .slider-track { cursor: default; }
  }
</style>

<script>
  const track = document.getElementById('sliderTrack');
  const set = document.getElementById('sliderSet');
  if (track && set) {
    // State
    let distance = 0;          // width of one set + gap (loop period)
    let offset = 0;            // current translateX (negative = scrolled left)
    let dragging = false;
    let startX = 0;
    let baseOffset = 0;
    let lastDx = 0;            // last drag delta (for click suppression)
    let paused = false;
    let resumeTimer: number | undefined;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const speed = reducedMotion ? 0 : 0.4;  // px per frame

    function measure() {
      const setW = set.offsetWidth;
      const gap = parseFloat(getComputedStyle(track).gap) || 20;
      distance = setW + gap;
      if (distance <= 0) distance = 1;
    }
    measure();
    window.addEventListener('resize', measure);

    // Seamless infinite loop: wrap offset into [-distance, 0)
    function apply() {
      if (distance <= 0) return;
      while (offset <= -distance) offset += distance;
      while (offset >= 0) offset -= distance;
      track.style.transform = `translateX(${offset}px)`;
    }

    function tick() {
      if (!dragging && !paused && speed > 0) {
        offset -= speed;
        apply();
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    function pauseAndResume(delay: number) {
      paused = true;
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => { paused = false; }, delay);
    }

    // Pointer drag — unified mouse / touch / pen
    track.addEventListener('pointerdown', (e: PointerEvent) => {
      // Only the primary pointer / left mouse button should move the carousel.
      if (!e.isPrimary || (e.pointerType === 'mouse' && e.button !== 0)) return;
      dragging = true;
      startX = e.clientX;
      baseOffset = offset;
      lastDx = 0;
      paused = true;
      window.clearTimeout(resumeTimer);
      try { track.setPointerCapture(e.pointerId); } catch (_) {}
      track.classList.add('dragging');
    });
    track.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      lastDx = dx;
      offset = baseOffset + dx;
      apply();
    });
    function endDrag(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      track.classList.remove('dragging');
      try { track.releasePointerCapture(e.pointerId); } catch (_) {}
      pauseAndResume(2500);
    }
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    // Images and links are draggable by default in desktop browsers. Preventing
    // that native drag keeps the carousel gesture continuous across card covers.
    track.addEventListener('dragstart', (e: DragEvent) => e.preventDefault());

    // Suppress click navigation when the user actually dragged (not a tap)
    track.addEventListener('click', (e: MouseEvent) => {
      if (Math.abs(lastDx) > 8) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    // Hover pause (desktop) — pause while reading, resume shortly after leave
    track.addEventListener('mouseenter', () => {
      if (!dragging) { paused = true; window.clearTimeout(resumeTimer); }
    });
    track.addEventListener('mouseleave', () => {
      if (!dragging) pauseAndResume(800);
    });
  }
</script>
