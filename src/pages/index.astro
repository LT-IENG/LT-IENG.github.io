---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedSlider from '../components/FeaturedSlider.astro';
import ResumeSection from '../components/ResumeSection.astro';
import ArticleGridCard from '../components/ArticleGridCard.astro';
import { sections } from '../data/sections';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
---

<BaseLayout title="首页">
  <Hero>
    <FeaturedSlider slot="slider" />
  </Hero>

  <ResumeSection />

  <!-- Scroll-driven card stack: single sticky viewport, absolute cards -->
  <div class="stack-scene" id="stackScene">
    <div class="stack-viewport" id="stackViewport">
      {sections.map((section, i) => {
        const posts = allPosts
          .filter((p) => p.data.section === section.id)
          .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
        // Prioritize pinned posts sorted by order, fill remaining with latest
        const pinnedPosts = posts
          .filter((p) => p.data.pinned)
          .sort((a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime());
        const otherPosts = posts.filter((p) => !p.data.pinned);
        const selected = [...pinnedPosts, ...otherPosts].slice(0, 4);
        const cards: (typeof posts[number] | null)[] = [
          ...selected,
          ...Array(Math.max(0, 4 - selected.length)).fill(null),
        ];
        const num = String(i + 1).padStart(2, '0');
        const isEven = i % 2 === 1;
        return (
          <div
            class="stack-card"
            id={`stack-card-${i}`}
            data-index={i}
            style={`--color: ${section.color}; --bg: ${isEven ? '#ffffff' : '#faf8f5'};`}
          >
            <div class="stack-card-inner">
              <header class="sc-head">
                <span class="sc-num">{num}</span>
                <h2 class="sc-title">{section.name}</h2>
                <p class="sc-desc">{section.description}</p>
                <a href={`/section/${encodeURIComponent(section.id)}`} class="sc-link">浏览全部 →</a>
              </header>
              <div class="sc-grid">
                {cards.map((card, j) => (
                  <div>
                    {card ? (
                      <ArticleGridCard post={card} sectionColor={section.color} />
                    ) : (
                      <ArticleGridCard sectionColor={section.color} placeholder="即将上线" />
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

</BaseLayout>

<style>
  .stack-scene {
    height: 500vh;
    position: relative;
  }
  .stack-viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .stack-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    background: var(--bg);
  }
  .stack-card-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  .sc-head {
    text-align: left;
  }
  .sc-num {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 8vw, 6.5rem);
    font-weight: 700;
    color: var(--color);
    opacity: 0.14;
    line-height: 1;
    margin-bottom: -0.25rem;
  }
  .sc-title {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 0.35rem;
    letter-spacing: -0.01em;
  }
  .sc-desc {
    font-size: 0.9rem;
    color: var(--color-ink-light);
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  .sc-link {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .sc-link:hover {
    border-color: var(--color);
  }
  .sc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 1fr;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .stack-scene { height: auto; }
    .stack-viewport {
      position: relative;
      top: auto;
      height: auto;
      overflow: visible;
    }
    .stack-card {
      position: relative;
      height: auto;
      min-height: auto;
      transform: none;
      opacity: 1;
    }
    .stack-card-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 4rem 1.25rem;
    }
    .sc-grid {
      grid-template-columns: 1fr;
    }
    .sc-head { text-align: center; }
  }
</style>

<script>
  (function() {
    var scene = document.getElementById('stackScene');
    var cards = document.querySelectorAll('.stack-card');
    if (!scene || cards.length === 0) return;

    // 滚动驱动动画仅在桌面端运行；移动端使用静态堆叠布局，避免无谓的 scroll 计算
    if (!window.matchMedia('(min-width: 769px)').matches) return;

    // Wider spacing: 15%, 35%, 55%, 75% → each card has 20% of scroll to shine
    var thresholds = [0.15, 0.35, 0.55, 0.75];
    // Track current state to avoid redundant style writes
    var currentStates = [-9, -9, -9, -9];
    // -9 = uninitialized, -1 = hidden below, 0 = active, 1 = covered

    function applyState(card, state, i) {
      if (state === -1) {
        // Hidden below: fully out of view to the bottom
        card.style.transition = 'transform 0.9s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.7s ease';
        card.style.transform = 'translateY(105%)';
        card.style.opacity = '0';
        card.style.zIndex = String(i + 1);
      } else if (state === 0) {
        // Active: fill the viewport
        card.style.transition = 'transform 0.9s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.7s ease';
        card.style.transform = 'translateY(0)';
        card.style.opacity = '1';
        card.style.zIndex = String(i + 1);
      } else if (state === 1) {
        // Covered: pushed up & faded behind the next card
        card.style.transition = 'transform 0.9s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.7s ease';
        card.style.transform = 'translateY(-10%)';
        card.style.opacity = '0';
        card.style.zIndex = String(i + 1);
      }
    }

    function update() {
      var rect = scene.getBoundingClientRect();
      var sceneHeight = scene.offsetHeight;
      var vh = window.innerHeight;
      var scrolled = -rect.top;
      var progress = Math.max(0, Math.min(1, scrolled / (sceneHeight - vh)));

      cards.forEach(function(card, i) {
        var t = thresholds[i];
        var prevState = currentStates[i];
        var newState;

        if (progress < t - 0.06) {
          newState = -1;  // not yet: below
        } else if (progress < t + 0.04) {
          newState = 0;   // transition zone & active
        } else if (i < cards.length - 1 && progress >= thresholds[i + 1] - 0.04) {
          newState = 1;   // next card taking over
        } else {
          newState = 0;   // active
        }

        if (newState !== prevState) {
          currentStates[i] = newState;
          applyState(card, newState, i);
        }
      });
    }

    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(function() { update(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });

    // Initialize
    cards.forEach(function(card, i) {
      if (i === 0) {
        applyState(card, 0, i);
        currentStates[i] = 0;
      } else {
        applyState(card, -1, i);
        currentStates[i] = -1;
      }
    });
    update();
  })();

  // Reveal elements: fade in when they enter viewport
  var revealObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(function(el) {
    revealObserver.observe(el);
  });
</script>
