---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于" description="关于 LT-IENG">
  <div class="about-page">
    <div class="about-header">
      <h1 class="about-title">关于</h1>
      <p class="about-subtitle">LT-IENG · 此刻，未来</p>
    </div>

    <div class="about-card card">
      <h2>👋 关于我</h2>
      <p>
        AI 技术爱好者 / 独立开发者 / 终身学习者。<br />
        深耕经济金融理论，研习宏观经济与金融市场 <br />
        热衷于探索大模型、智能体与 AI 应用开发，<br />
        喜欢用代码构建有趣的产品，记录思考与成长。
      </p>
    </div>

    <div class="about-card card">
      <h2>🛠️ 技能 & 兴趣</h2>
      <div class="about-tags">
        <span class="about-tag">AI / LLM</span>
        <span class="about-tag">Agent</span>
        <span class="about-tag">Python</span>
        <span class="about-tag">全栈开发</span>
        <span class="about-tag">Stable Diffusion</span>
        <span class="about-tag">经济学</span>
        <span class="about-tag">开源</span>
      </div>
    </div>

    <div class="about-card card">
      <h2>📬 联系</h2>
      <div class="about-links">
        <a href="https://github.com/LT-IENG" target="_blank" rel="noopener" class="about-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
        <a href="mailto:contact@lt-ieng.cn" class="about-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email
        </a>
      </div>
    </div>

    <div class="about-card card">
      <h2>🏗️ 关于本站</h2>
      <p>
        使用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建，
        部署于 <a href="https://pages.github.com" target="_blank" rel="noopener">GitHub Pages</a>。<br />
        内容采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a> 许可。
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    max-width: 640px;
    margin: 0 auto;
    padding: 6rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .about-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .about-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }
  .about-subtitle {
    color: var(--color-gold);
    font-size: 1rem;
  }
  .about-card {
    padding: 1.5rem 1.75rem;
  }
  .about-card h2 {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
    color: var(--color-ink);
  }
  .about-card p {
    font-size: 0.95rem;
    color: var(--color-ink-light);
    line-height: 1.8;
    margin: 0;
  }
  .about-card a {
    color: var(--color-gold);
    text-decoration: none;
  }
  .about-card a:hover {
    text-decoration: underline;
  }
  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .about-tag {
    padding: 3px 12px;
    border-radius: 100px;
    font-size: 0.82rem;
    background: var(--color-warm-white);
    color: var(--color-ink-light);
  }
  .about-links {
    display: flex;
    gap: 1.5rem;
  }
  .about-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink-light);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .about-link:hover {
    color: var(--color-gold);
  }
</style>
