---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getAdjacentPosts } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings: tocHeadings } = await post.render();
const { data } = post;
const { prev, next } = await getAdjacentPosts(post.slug);

const sectionColors: Record<string, string> = {
  '项目作品': '#c4a882',
  '技术探索': '#5b7a8c',
  '阅读笔记': '#b8937a',
  '闲隅拾笺': '#8b9d83',
};

const readingTime = Math.max(1, Math.ceil(post.body.split(/\s+/).length / 300));
---

<BaseLayout title={data.title} description={data.description}>
  <article class="post">
    {data.hero && (
      <div class="post-banner">
        <img src={data.hero} alt={data.title} />
      </div>
    )}
    <header class="post-header">
      <div class="post-meta-top">
        <span class="section-tag" style={`background: ${sectionColors[data.section] || '#6b7280'}18; color: ${sectionColors[data.section] || '#6b7280'}`}>
          {data.section}
        </span>
        <time>{data.date.toISOString().slice(0, 10)}</time>
        <span>{readingTime} 分钟阅读</span>
        {data.updated && data.updated > data.date && (
          <span class="post-updated">更新于 {data.updated.toISOString().slice(0, 10)}</span>
        )}
      </div>
      <h1 class="post-title">{data.title}</h1>
      {data.tags.length > 0 && (
        <div class="post-tags">
          {data.tags.map((t: string) => <span class="post-tag">{t}</span>)}
        </div>
      )}
    </header>


    <div class={`post-layout ${!data.toc ? 'post-layout--full' : ''}`}>
      {data.toc !== false && (
        <aside class="post-sidebar">
          <TableOfContents headings={tocHeadings ?? []} />
        </aside>
      )}
      <div class="post-body prose">
        <Content />
      </div>
    </div>

    <footer class="post-footer">
      <div class="post-license">
        <p>本文采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a> 许可协议。转载请注明出处。</p>
      </div>

      <nav class="post-pagination">
        {prev ? (
          <a href={`/blog/${prev.slug}`} class="post-prev link-underline">
            <span class="post-pagination-label">← 上一篇</span>
            <span class="post-pagination-title">{prev.data.title}</span>
          </a>
        ) : <div />}
        {next ? (
          <a href={`/blog/${next.slug}`} class="post-next link-underline">
            <span class="post-pagination-label">下一篇 →</span>
            <span class="post-pagination-title">{next.data.title}</span>
          </a>
        ) : <div />}
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding: 0 2rem 4rem;
  }
  .post-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-top: 3rem;
  }
  .post-meta-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--color-ink-light);
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .post-updated {
    font-style: italic;
  }
  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink);
    max-width: 720px;
    margin: 0 auto;
  }
  .post-tags {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }
  .post-tag {
    padding: 2px 10px;
    border-radius: 100px;
    font-size: 0.75rem;
    background: var(--color-warm-white);
    color: var(--color-ink-light);
  }
  .post-banner {
    width: 100%;
    max-height: 50vh;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }
  .post-banner img {
    width: 100%;
    height: 50vh;
    object-fit: cover;
    display: block;
  }
  .post-layout {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    max-width: 960px;
    margin: 0 auto 3rem;
  }
  .post-body {
    min-width: 0;
  }
  .post-footer {
    max-width: 720px;
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }
  .post-license {
    text-align: center;
    font-size: 0.82rem;
    color: var(--color-ink-light);
    margin-bottom: 2rem;
  }
  .post-license a {
    color: var(--color-gold);
  }
  .post-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .post-pagination a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .post-next {
    text-align: right;
  }
  .post-pagination-label {
    font-size: 0.78rem;
    color: var(--color-ink-light);
    margin-bottom: 0.25rem;
  }
  .post-pagination-title {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .post-layout--full {
    grid-template-columns: 1fr;
  }
  .post-layout--full .post-sidebar {
    display: none;
  }

  @media (max-width: 768px) {
    .post {
      padding: 0 1rem 3rem;
    }
    .post-header {
      padding-top: 2rem;
    }
    .post-banner {
      max-height: 240px;
      margin-bottom: 1.5rem;
    }
    .post-banner img {
      height: 240px;
    }
    .post-layout {
      grid-template-columns: 1fr;
    }
    .post-pagination {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .post-next {
      text-align: left;
    }
  }
</style>
